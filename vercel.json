{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/health/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
