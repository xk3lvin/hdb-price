# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OneMap Singapore SLA API Token (Recommended)
# When set in the environment, all visitors automatically get full access
# to Singapore OneMap SLA address search, reverse geocoding, and routing
# without needing to key in or manage any tokens.
# Token can be generated from: https://www.onemap.gov.sg/developers/
VITE_ONEMAP_TOKEN=""
ONEMAP_API_TOKEN=""

# Optional OneMap credentials (for auto-minting 3-day tokens)
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""
